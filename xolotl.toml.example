# Copy to `xolotl.toml` in your working directory, or set XOLOTL_CONFIG=/path/to/config.toml.
#
# This file covers daemon bootstrap. Runtime model config, routing, bindings,
# Provider/Source projections, and policy live in Xolotl state and are managed
# through Console.

[storage]
kind = "redb"           # "redb" (persistent) or "memory" (non-persistent)
path = "xolotl.db"       # single redb file for state and FactStore tables

[server]
console_addr = "127.0.0.1:9000"
external_grpc_addr = "127.0.0.1:9444"
external_websocket_addr = "127.0.0.1:9200"

[external_gateway.grpc]
# External gRPC accepts Provider and Source role sessions.
source_dedupe_window_ms = 86400000
provider_max_in_flight_invocations = 1024
provider_max_in_flight_per_identity = 256
provider_max_in_flight_per_effect = 256
provider_max_inline_result_bytes = 65536
source_max_in_flight_commands = 1024
source_command_max_inline_result_bytes = 65536
source_command_rate_limit_window_ms = 60000
source_command_rate_limit_max = 600

[external_gateway.grpc.transport_security]
mode = "local_trusted" # production_tls | mtls | trusted_reverse_proxy | local_trusted | unsafe_plaintext | disabled_for_test
# trusted_proxy_peers = ["127.0.0.1"]
# honor_x_forwarded_proto = true
# honor_x_forwarded_host = true
# honor_x_forwarded_for = true
# certificate_chain_path = "/etc/xolotl/external-grpc-cert.pem"
# private_key_path = "/etc/xolotl/external-grpc-key.pem"
# client_trust_roots = ["/etc/xolotl/external-client-ca.pem"]
# unsafe_relaxations = ["ignore_origin_port"]

[external_gateway.websocket]
# External WebSocket is another transport for Provider and Source role sessions.
source_dedupe_window_ms = 86400000
provider_max_in_flight_invocations = 1024
provider_max_in_flight_per_identity = 256
provider_max_in_flight_per_effect = 256
provider_max_inline_result_bytes = 65536
source_max_in_flight_commands = 1024
source_command_max_inline_result_bytes = 65536
source_command_rate_limit_window_ms = 60000
source_command_rate_limit_max = 600

[external_gateway.websocket.transport]
max_frame_bytes = 1048576
first_frame_timeout_ms = 10000
idle_timeout_ms = 300000
max_connections = 256

[external_gateway.websocket.transport_security]
# External WebSocket is a plain listener. Use trusted_reverse_proxy for external
# TLS termination; production_tls and mtls fail closed here.
mode = "local_trusted" # trusted_reverse_proxy | local_trusted | unsafe_plaintext | disabled_for_test
# trusted_proxy_peers = ["127.0.0.1"]
# honor_x_forwarded_proto = true
# honor_x_forwarded_host = true
# honor_x_forwarded_for = true
# unsafe_relaxations = ["ignore_origin_port"]

# Optional root bootstrap.
# If omitted and state://kernel/console/users/* is empty, xolotld creates root
# with a random one-time password printed to stderr.
[console.root]
# password_hash = "$argon2id$v=19$m=65536,t=3,p=2$..."
# pubkeys = ["ed25519:..."]

# Console authentication/session limits.
[console.auth]
session_ttl_ms = 86400000          # 24h absolute session TTL
idle_ttl_ms = 7200000              # 2h idle TTL
max_sessions_per_user = 5
global_session_limit = 10000
# argon2_concurrency defaults to available CPU parallelism.
# argon2_concurrency = 4

# Console transport security. The daemon console listener is plain.
# Use local_trusted for loopback development or trusted_reverse_proxy when
# another service terminates TLS.
[console.transport_security]
mode = "local_trusted" # production_tls | trusted_reverse_proxy | local_trusted | unsafe_plaintext | disabled_for_test
# trusted_proxy_peers = ["127.0.0.1"]
# honor_x_forwarded_proto = true
# honor_x_forwarded_host = true
# honor_x_forwarded_for = true
# unsafe_relaxations = ["ignore_origin_port"]

# Console WebSocket limits.
[console.ws]
max_frame_bytes = 1048576          # 1 MiB; hard-capped by backend at 4 MiB
max_connections_global = 256
max_connections_per_source = 32
max_connections_per_user = 8
idle_timeout_secs = 7200           # 2h
max_frames_per_second = 64
max_bytes_per_second = 4194304     # 4 MiB/s
max_subscriptions = 32
max_state_list_limit = 512
max_fact_limit = 256
max_trace_limit = 512
event_send_timeout_ms = 5000
